# =================================================================
# FastAPI Backend Configuration
# =================================================================

PROJECT_NAME="ATOMS Bus Management SaaS"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# 🐘 PostgreSQL Database URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bus_management?sslmode=disable"

# 🔒 Security & JWT Secret Keys
# Generate strong values with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start in production with placeholder or missing keys.
SECRET_KEY=""
FERNET_SECRET_KEY=""
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15  # 15 minutes (Short-lived session)

# 🌐 CORS Configuration (Frontend Next.js URLs)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# 🏢 SaaS Platform Settings
DEFAULT_TENANT_ID="central-transit"
CRON_SECRET=""

# 🤖 AI API Keys (optional — leave as-is to disable AI features)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
GROQ_API_KEY="YOUR_GROQ_API_KEY_HERE"
