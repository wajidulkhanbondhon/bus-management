# Environment variables for Admission Transport Office Management System (ATOMS)

# -----------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------
# For PostgreSQL: Replace user, password, host, port, and dbname with your PostgreSQL credentials
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bus_management?sslmode=disable"

# For SQLite (Local development fallback):
# DATABASE_URL="sqlite:///./atoms_bus.db"

# -----------------------------------------------------------------
# SYSTEM CONFIGURATION
# -----------------------------------------------------------------
APP_TIMEZONE="Asia/Dhaka"
APP_CURRENCY="BDT"

# -----------------------------------------------------------------
# SECURITY — MUST be set to strong random values.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# -----------------------------------------------------------------
# Backend JWT signing key (required in production — the app refuses to start
# in production if this is missing or is a known placeholder).
JWT_SECRET=""

# HMAC secret used by the Next.js server to sign the session cookie.
# Also required in production; the frontend refuses to boot without it.
SESSION_SECRET=""

# Fernet key used for encrypting sensitive fields (backend).
FERNET_SECRET_KEY=""

# Shared secret for the cron cleanup endpoint (backend + frontend cron route).
CRON_SECRET=""

NEXT_PUBLIC_APP_NAME="ATOMS Admission Transport System"

# -----------------------------------------------------------------
# FRONTEND → BACKEND
# -----------------------------------------------------------------
# Base URL of the FastAPI backend, used by the Next.js API proxy.
# In production this must be the public HTTPS URL of the backend.
NEXT_PUBLIC_FASTAPI_URL="http://localhost:8000/api/v1"
