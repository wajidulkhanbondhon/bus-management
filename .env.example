# Environment variables for Admission Transport Office Management System (ATOMS)

# -----------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------
# For PostgreSQL: Replace user, password, host, port, and dbname with your PostgreSQL credentials
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bus_management?schema=public"

# For SQLite (Local development fallback):
# DATABASE_URL="file:./dev.db"

# -----------------------------------------------------------------
# SYSTEM CONFIGURATION
# -----------------------------------------------------------------
APP_TIMEZONE="Asia/Dhaka"
APP_CURRENCY="BDT"
JWT_SECRET="atoms_secure_jwt_secret_admission_transport_office_2026"
SESSION_SECRET="atoms_session_hmac_secret_2026_change_in_prod"
CRON_SECRET="atoms-cleanup-token"
NEXT_PUBLIC_APP_NAME="ATOMS Admission Transport System"
