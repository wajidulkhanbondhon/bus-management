# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.bak

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env*.local
.env.development
.env.production
!.env.example
!backend/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# sqlite & databases
*.db
*.db-journal
prisma/*.db
backend/*.db
backend/*.sqlite3

# python & venvs
__pycache__/
*.pyc
*.pyo
.venv/
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/

# local temporary & runtime storage
bd_path.txt
*.sql
*.sql.gz
*.dump
bus_management_backup.sql
backend/backups/*.enc
backend/uploads/images/*
backend/uploads/documents/*
!backend/uploads/images/.gitkeep
!backend/uploads/documents/.gitkeep
!backend/backups/.gitkeep
